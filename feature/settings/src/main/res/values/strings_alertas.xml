    <string name="settings_alertas_cameras_title">Speed cameras</string>
    <string name="settings_alertas_cameras_description">Downloads speed cameras within %1$d %2$s of you. Sources: OpenStreetMap + official ANSV registry · updates automatically every week. While driving, the app warns you by voice as you approach (works offline after downloading).</string>
