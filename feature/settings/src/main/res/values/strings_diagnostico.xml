    <string name="settings_diagnostico_auto_backup_weekly">Weekly automatic backup</string>
    <string name="settings_diagnostico_auto_backup_description">Every week saves a backup in Downloads/RevScope (the last 4 are kept).</string>
    <string name="settings_diagnostico_mcp_title">MCP server (local network)</string>
    <string name="settings_diagnostico_mcp_description">Exposes your vehicle status to AI assistants on your Wi‑Fi network (Claude Desktop, LM Studio…): connection, trips, checks, DTCs, maintenance, and documents. Off by default — enable it only on trusted networks.</string>
