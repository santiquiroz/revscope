    <string name="settings_diagnostico_import">Import</string>
    <string name="settings_diagnostico_alerts_title">Custom PID alerts</string>
    <string name="settings_diagnostico_alerts_description">Threshold per PID in JSON: [{\"pid\":\"0A\",\"min\":200,\"nombre\":\"Fuel pressure\"}]. For TPMS or other manufacturer sensors, first define the custom PID (Mode 22) and then its alert here.</string>
    <string name="settings_diagnostico_alerts_json_label">Custom alert JSON</string>
    <string name="settings_diagnostico_backup_title">Backup</string>
    <string name="settings_diagnostico_backup_description">Includes trips, profiles, reports, and settings. The API key is NOT included (it stays encrypted on this device) — save it again after restoring.</string>
    <string name="settings_diagnostico_backup_restored">Backup restored — restarting…</string>
    <string name="settings_diagnostico_export_copy">Export backup</string>
