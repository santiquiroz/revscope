    <string name="settings_diagnostico_detect_title">Crash detection</string>
    <string name="settings_diagnostico_crash_subject_car">a possible crash</string>
    <string name="settings_diagnostico_crash_subject_motorcycle">a possible motorcycle accident</string>
    <string name="settings_diagnostico_detect_description">If it detects %1$s, it triggers a full-screen alarm with a 60-second countdown. If you don\'t respond \"I\'M OK\", it sends an SMS with your last location to the emergency contact. Off by default.</string>
    <string name="settings_diagnostico_emergency_phone_label">Emergency contact</string>
    <string name="settings_diagnostico_save_phone">Save phone</string>
    <string name="settings_diagnostico_enable_detection">Enable crash detection</string>
    <string name="settings_diagnostico_detection_requires">Requires a saved emergency phone number and SMS permission.</string>
    <string name="settings_diagnostico_test_alert">Test (without sending real SMS)</string>
    <string name="settings_diagnostico_guard_title">Anti-theft guard mode</string>
    <string name="settings_diagnostico_guard_description">With the motorcycle off and parked nearby, the phone watches the OBD adapter: if it wakes up (someone turned the key), it sounds a loud alarm. Requires being within Bluetooth range (~10–30 m) — covers quick theft, not remote surveillance.</string>
    <string name="settings_diagnostico_guard_toggle">Guard mode</string>
    <string name="settings_diagnostico_guard_alarm_active">⚠ ALARM ACTIVE — the adapter woke up!</string>
    <string name="settings_diagnostico_pids_title">Custom PIDs</string>
    <string name="settings_diagnostico_pids_description">Extra definitions in JSON (same schema as pids_mode01.json). For manufacturer parameters, e.g. drive mode via Mode 22.</string>
    <string name="settings_diagnostico_custom_pids_label">Custom PID JSON</string>
