    <string name="settings_diagnostico_alerts_title">Alertas personalizadas por PID</string>
    <string name="settings_diagnostico_alerts_description">Umbral por PID en JSON: [{\"pid\":\"0A\",\"min\":200,\"nombre\":\"Presión de combustible\"}]. Para TPMS u otros sensores del fabricante, define primero el PID custom (Modo 22) y luego su alerta aquí.</string>
    <string name="settings_diagnostico_alerts_json_label">JSON de alertas custom</string>
    <string name="settings_diagnostico_backup_title">Copia de seguridad</string>
    <string name="settings_diagnostico_backup_description">Incluye viajes, perfiles, informes y ajustes. La API key NO se incluye (queda cifrada en este dispositivo) — guárdala de nuevo después de restaurar.</string>
