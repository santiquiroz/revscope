    <string name="settings_diagnostico_enable_detection">Activar detección de caída</string>
    <string name="settings_diagnostico_detection_requires">Requiere teléfono de emergencia guardado y permiso de SMS.</string>
    <string name="settings_diagnostico_test_alert">Probar (sin enviar SMS real)</string>
    <string name="settings_diagnostico_guard_title">Modo guardia antirrobo</string>
    <string name="settings_diagnostico_guard_description">Con la moto apagada y parqueada cerca, el teléfono vigila el adaptador OBD: si despierta (alguien giró la llave), suena una alarma fuerte. Requiere estar en rango Bluetooth (~10-30 m) — cubre el robo exprés, no vigilancia remota.</string>
    <string name="settings_diagnostico_guard_toggle">Modo guardia</string>
    <string name="settings_diagnostico_guard_alarm_active">⚠ ¡ALARMA ACTIVA — el adaptador despertó!</string>
    <string name="settings_diagnostico_pids_title">PIDs personalizados</string>
    <string name="settings_diagnostico_pids_description">Definiciones extra en JSON (mismo esquema que pids_mode01.json). Para parámetros del fabricante, p. ej. modo de manejo vía Modo 22.</string>
    <string name="settings_diagnostico_custom_pids_label">JSON de PIDs custom</string>
