    <string name="workshop_prueba_modo_grabar_hasta_meta">graba hasta cumplir la meta o hasta que toques «Terminar» (máx. %1$s)</string>
    <string name="workshop_prueba_modo_grabar_hasta">graba hasta que toques «Terminar» (máx. %1$s)</string>
    <string name="workshop_prueba_modo_accion">graba hasta detectar el evento o hasta que toques «Terminar» (máx. %1$s)</string>
    <string name="workshop_prueba_subtexto_posicionando">Cuando esté en posición, toca «Listo».</string>
    <string name="workshop_prueba_subtexto_sosteniendo">Sostenlo quieto hasta que la cuenta llegue a&#160;0.</string>
    <string name="workshop_prueba_subtexto_accion">Termina solo al detectarlo; si no, toca «Terminar».</string>
    <string name="workshop_prueba_subtexto_toque">Toca «Terminar» cuando acabes.</string>
