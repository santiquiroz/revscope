<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: the Keystore key never leaves the device, so the encrypted prefs would arrive unreadable. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="revscope_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="revscope_secure.xml" />
    </device-transfer>
</data-extraction-rules>
