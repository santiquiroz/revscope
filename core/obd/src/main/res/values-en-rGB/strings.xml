    <!-- strings_pruebas_a.xml -->
    <string name="obd_bateria_comprobacion_contacto_farola">Battery, ignition on (headlamp on)</string>
    <string name="obd_bateria_aviso_farola">On many motorbikes the headlamp stays on with the ignition (AHO), and that lowers the voltage.</string>
    <string name="obd_bateria_condicion_farola">with the headlamp on</string>
    <string name="obd_bateria_veredicto_sin_carga_en_minimo">At idle it does not rise above rest: on small motorbikes this can be normal, but with the lights on the battery discharges.</string>
    <string name="obd_minimo_compatibilidad">Consistent with poorly controlled idle: idle air valve or stepper motor, a dirty throttle body, a vacuum leak, or a TPS signal the ECU does not recognise as idle.</string>
    <string name="obd_minimo_tps_bajo">the ECU may not recognise the idle position</string>

    <!-- strings_pruebas_arranque.xml -->
    <string name="obd_arranque_nota_aire">On air-cooled motorbikes, the “engine” sensor usually reads the cylinder head or the oil: it rises differently than coolant.</string>

